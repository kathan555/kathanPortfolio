# ─────────────────────────────────────────────────────────────────
# Copy to .env.local and fill in. .env.local is gitignored; THIS file is
# committed to a public repo, so it must never contain a real value.
# ─────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────
# Supabase — https://supabase.com/dashboard/project/_/settings/api
# The anon key is safe in the browser (it ships in the client bundle), but it
# is only as safe as the RLS policies behind it — check those before assuming
# a table is protected.
# ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://mwpxptduqzsacgxjzdlr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im13cHhwdGR1cXpzYWNneGp6ZGxyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzY4MzE1MjgsImV4cCI6MjA5MjQwNzUyOH0.eyQbG6BmQuMud6eWB4s0eCR31aaKPw2zSar9gHpIHSg

# ─────────────────────────────────────────────────────────────────
# Cloudflare Turnstile (free) — https://dash.cloudflare.com → Turnstile → Add Site
# SITE_KEY:   safe to expose publicly (used in browser)
# SECRET_KEY: server-only (never expose in client code)
#
# The values below are Cloudflare's DOCUMENTED TEST KEYS, not secrets — the
# site key always passes and the secret key always validates, which is what you
# want for local development. Replace both with your real keys in production.
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ─────────────────────────────────────────────────────────────────
# Google Gemini — powers the homepage assistant, the /ai-integration demo,
# the project cost estimator, and the job radar's scoring + web search.
# Get a free key at: https://aistudio.google.com/apikey
# ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key

# ─────────────────────────────────────────────────────────────────
# Gmail SMTP — sends estimator PDFs and the job radar digest
# (works with @gmail.com; no custom domain needed)
# Create an App Password: Google Account → Security → 2-Step Verification → App passwords
# ─────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=patel.kathan555@gmail.com
SMTP_PASS=naoxikcwz...
SMTP_FROM=patel.kathan555@gmail.com

# ─────────────────────────────────────────────────────────────────
# Calendar booking — Cal.com or Calendly embed URL (free tier)
# Example: https://cal.com/your-username/30min
# ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CALENDAR_BOOKING_URL=https://cal.com/kathanpatel9/30min

# ── Job Radar (daily contract-opportunity scan) ──────────────────────────
# Setup, schema and tuning: docs/job-radar.md

# Vercel sends this automatically as `Authorization: Bearer <secret>` on cron
# invocations. Without it the scan endpoint refuses every request, and the
# /opportunities dashboard (whose token is derived from this) stays closed.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Supabase → Settings → API Keys → the `sb_secret_...` key (the legacy
# `service_role` JWT also works, but Supabase deprecates it end of 2026).
# job_leads has RLS enabled with NO policies, so the public anon key cannot
# reach it at all and this key is required.
# SERVER-ONLY — never import into a client component, never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_DC5BbHntbN9XfixWCj0fYw_...

# The digest goes to personalInfo.email in lib/data.ts, and the /opportunities
# dashboard token is derived from CRON_SECRET — neither needs its own variable.
# Print your dashboard URL with: npm run job-radar:url
